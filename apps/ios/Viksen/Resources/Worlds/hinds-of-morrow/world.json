        "width": 20
      }
    },
    {
      "id": "percussion",
      "file": "percussion.m4a",
      "title": "Percussion",
      "spatial": {
        "azimuth": -25,
        "elevation": 0,
        "distance": 1.5,
        "width": 50
      }
    }
  ],
  "rules": [
    {
      "stem": "strings",
      "when": {
        "all": [
          {
            "type": "quiet"
          }
        ]
      },
      "gainDb": 0,
      "otherwiseDb": -8,
      "label": "Strings bloom when it is quiet"
    },
    {
      "stem": "woodwinds",
      "when": {
        "all": [
          {
            "type": "quiet"
          }
        ]
      },
      "gainDb": 0,
      "otherwiseDb": -60,
      "label": "Woodwinds drift in when it is quiet"
    },
    {
      "stem": "woodwinds",
      "when": {
        "all": [
          {
            "type": "still"
          }
        ]
      },
      "gainDb": 0,
      "otherwiseDb": -60,
      "label": "Woodwinds drift in when you are still"
    },
    {
      "stem": "synth",
      "when": {
        "all": [
          {
            "type": "loud"
          }
        ]
      },
      "gainDb": 0,
      "otherwiseDb": -10,
      "label": "Synth rises with loud surroundings"
    },
    {
      "stem": "guitar",
      "when": {
        "all": [
          {
            "type": "moving"
          }
        ]
      },
      "gainDb": 0,
      "otherwiseDb": -14,
      "label": "Guitar joins when you move"
    },
    {
      "stem": "bass",
      "when": {
        "all": [
          {
            "type": "moving"
          }
        ]
      },
      "gainDb": 0,
      "otherwiseDb": -10,
      "label": "Bass follows your movement"
    },
    {
      "stem": "bass",
      "when": {
        "all": [
          {
            "type": "intensityAtLeast",
            "value": 0.35
          }
        ]
      },
      "gainDb": 2,
      "otherwiseDb": -10,
      "label": "Bass drives harder as you work out"
    },
    {
      "stem": "percussion",
      "when": {
        "all": [
          {
            "type": "moving"
          }
        ]
      },
      "gainDb": 0,
      "otherwiseDb": -60,
      "label": "Percussion starts when you move"
    },
    {
      "stem": "percussion",
      "when": {
        "all": [
          {
            "type": "intensityAtLeast",
            "value": 0.5
          }
        ]
      },
      "gainDb": 2,
      "otherwiseDb": -60,
      "label": "Percussion pushes with your heart rate"
    }
  ]
}
