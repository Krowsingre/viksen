      "title": "Woodwinds",
      "spatial": {
        "azimuth": -55,
        "elevation": 10,
        "distance": 2.0,
        "width": 30
      }
    },
    {
      "id": "synth",
      "file": "synth.m4a",
      "title": "Synth",
