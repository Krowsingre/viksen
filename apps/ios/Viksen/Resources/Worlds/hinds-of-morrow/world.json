{
  "format": "atmos.world",
  "schemaVersion": 1,
  "id": "hinds-of-morrow",
  "name": "The Hinds of Morrow",
  "artist": "Krowsingre",
  "tier": "free",
  "music": {
    "tempo": 110,
    "key": "G minor",
    "loop": {
      "fromSeconds": 0,
      "toSeconds": null
    },
    "beatsPerBar": 4,
    "barOffsetSeconds": 0
  },
  "fadeSeconds": 4,
  "stems": [
    {
      "id": "keyboard",
      "file": "keyboard.m4a",
      "title": "Keyboard",
      "spatial": {
        "azimuth": 0,
        "elevation": 0,
        "distance": 1.8,
        "width": 70
      }
    },
    {
      "id": "strings",
      "file": "strings.m4a",
      "title": "Strings",
      "spatial": {
        "azimuth": 0,
        "elevation": 15,
        "distance": 2.5,
        "width": 140
      }
    },
    {
      "id": "woodwinds",
      "file": "woodwinds.m4a",
      "title": "Woodwinds",
      "spatial": {
        "azimuth": -55,
        "elevation": 10,
        "distance": 2.0,
        "width": 30
      }
    },
    {
      "id": "synth",
      "file": "synth.m4a",
      "title": "Synth",
      "spatial": {
        "azimuth": 180,
        "elevation": 25,
        "distance": 3.0,
        "width": 90
      }
    },
    {
      "id": "guitar",
      "file": "guitar.m4a",
      "title": "Guitar",
      "spatial": {
        "azimuth": 60,
        "elevation": 0,
        "distance": 1.6,
        "width": 30
      }
    },
    {
      "id": "bass",
      "file": "bass.m4a",
      "title": "Bass",
      "spatial": {
        "azimuth": 0,
        "elevation": -10,
        "distance": 1.4,
        "width": 20
      }
    },
    {
      "id": "percussion",
      "file": "percussion.m4a",
      "title": "Percussion",
      "spatial": {
        "azimuth": -25,
        "elevation": 0,
        "distance": 1.5,
        "width": 50
      }
    }
  ],
  "rules": [
    {
      "stem": "strings",
      "when": {
        "all": [
          {
            "type": "quiet"
          }
        ]
      },
      "gainDb": 0,
      "otherwiseDb": -4,
      "label": "Strings open up in the quiet"
    },
    {
      "stem": "woodwinds",
      "when": {
        "all": [
          {
            "type": "still"
          }
        ]
      },
      "gainDb": 0,
      "otherwiseDb": -5,
      "label": "Woodwinds come close when you are still"
    },
    {
      "stem": "synth",
      "when": {
        "all": [
          {
            "type": "loud"
          }
        ]
      },
      "gainDb": 2,
      "otherwiseDb": 0,
      "label": "Synth rises over loud surroundings"
    },
    {
      "stem": "percussion",
      "when": {
        "all": [
          {
            "type": "intensityAtLeast",
            "value": 0.5
          }
        ]
      },
      "gainDb": 3,
      "otherwiseDb": 0,
      "label": "Percussion pushes with your heart rate"
    },
    {
      "stem": "bass",
      "when": {
        "all": [
          {
            "type": "moving"
          }
        ]
      },
      "gainDb": 1,
      "otherwiseDb": -2,
      "label": "Bass follows your stride"
    }
  ],
  "adaptive": {
    "jumpEveryBars": 4,
    "minStayBars": 8,
    "crossfadeBeats": 1
  },
  "sections": [
    {
      "id": "first-light",
      "title": "First Light",
      "fromBar": 0,
      "toBar": 16,
      "label": "You are still",
      "when": {
        "all": [
          {
            "type": "still"
          }
        ]
      },
      "prefer": {
        "all": [
          {
            "type": "timeWindow",
            "from": 21,
            "to": 5
          }
        ]
      }
    },
    {
      "id": "gathering",
      "title": "Gathering",
