<Application
    x:Class="Viksen.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Background and cards follow the chosen appearance (Dark is the default). -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="VkBackgroundBrush" Color="#FF080812" />
                    <SolidColorBrush x:Key="VkCardBrush" Color="#FF17142A" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="VkBackgroundBrush" Color="#FFF4F2FA" />
                    <SolidColorBrush x:Key="VkCardBrush" Color="#FFFFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- Same palette as iPhone/Mac (Shared/Theme.swift): deep violet. -->
            <Color x:Key="VkAccent">#FF8C73FA</Color>
            <Color x:Key="VkAccentGlow">#FF9E66FF</Color>
            <Color x:Key="VkBackground">#FF080812</Color>
            <Color x:Key="VkCard">#FF17142A</Color>
            <Color x:Key="VkMusic">#FF739EFF</Color>
            <Color x:Key="VkAtmosphere">#FF59D1BD</Color>
            <Color x:Key="VkMicRaw">#FFFFB84D</Color>
            <Color x:Key="VkMicTransformed">#FFBD8CFF</Color>
            <Color x:Key="VkDanger">#FFFF4D4D</Color>
            <SolidColorBrush x:Key="VkAccentBrush" Color="{StaticResource VkAccent}" />
            <SolidColorBrush x:Key="VkMusicBrush" Color="{StaticResource VkMusic}" />
            <SolidColorBrush x:Key="VkAtmosphereBrush" Color="{StaticResource VkAtmosphere}" />
            <SolidColorBrush x:Key="VkMicRawBrush" Color="{StaticResource VkMicRaw}" />
            <SolidColorBrush x:Key="VkMicTransformedBrush" Color="{StaticResource VkMicTransformed}" />
            <SolidColorBrush x:Key="VkDangerBrush" Color="{StaticResource VkDanger}" />
            <Color x:Key="SystemAccentColor">#FF8C73FA</Color>

            <Style x:Key="VkCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource VkCardBrush}" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="VkSectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Opacity" Value="0.7" />
                <Setter Property="Margin" Value="4,16,0,6" />
                <Setter Property="CharacterSpacing" Value="40" />
            </Style>
            <Style x:Key="VkFootnote" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Opacity" Value="0.6" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="4,6,4,0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
