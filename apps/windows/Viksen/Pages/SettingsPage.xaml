<Page
    x:Class="Viksen.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource VkBackgroundBrush}">
    <ScrollViewer>
        <StackPanel MaxWidth="720" Padding="24" Spacing="4">
            <TextBlock Text="Settings" FontSize="32" FontWeight="Light" />

            <TextBlock Text="APPEARANCE" Style="{StaticResource VkSectionHeader}" />
            <Border Style="{StaticResource VkCardStyle}">
                <RadioButtons x:Name="AppearanceChoice" SelectionChanged="OnAppearance">
                    <x:String>Dark</x:String>
                    <x:String>Light</x:String>
                    <x:String>System</x:String>
                </RadioButtons>
            </Border>

            <TextBlock Text="SAFETY" Style="{StaticResource VkSectionHeader}" />
            <Border Style="{StaticResource VkCardStyle}">
                <Slider x:Name="Ceiling" Header="Output ceiling (dB)" Minimum="-24" Maximum="0" StepFrequency="0.5" ValueChanged="OnCeiling" />
            </Border>

            <TextBlock Text="PRIVACY" Style="{StaticResource VkSectionHeader}" />
            <Border Style="{StaticResource VkCardStyle}">
                <TextBlock TextWrapping="Wrap" Text="All processing happens on this PC. Nothing is ever recorded or saved, and nothing is uploaded. No account is required." />
            </Border>

            <TextBlock Text="DIAGNOSTICS" Style="{StaticResource VkSectionHeader}" />
            <Border Style="{StaticResource VkCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="EngineInfo" Opacity="0.75" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource VkFootnote}" Text="The log records app events (audio start/stop, errors). It never contains audio or your files, and it stays on this PC unless you share it." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Show log" Click="OnShowLog" />
                        <Button Content="Clear log" Click="OnClearLog" />
                    </StackPanel>
                    <TextBox x:Name="LogText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="320"
                             FontFamily="Consolas" FontSize="11" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <TextBlock Text="ABOUT" Style="{StaticResource VkSectionHeader}" />
            <Border Style="{StaticResource VkCardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Viksen: Aural Dimensions" FontSize="16" />
                    <TextBlock x:Name="VersionText" Opacity="0.7" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.8"
                               Text="Music by Krowsingre. Spatial audio by Steam Audio (Apache-2.0, Valve). Audio I/O by miniaudio (MIT-0). JSON for Modern C++ (MIT). PFFFT (BSD-like)." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
