<Page
    x:Class="Viksen.Pages.DimensionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Viksen.Controls"
    xmlns:engine="using:Viksen.Engine"
    Background="{ThemeResource VkBackgroundBrush}">
    <Grid Padding="24" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Text="Dimensions" FontSize="32" FontWeight="Light" Grid.ColumnSpan="2" Margin="0,0,0,12" />
        <ListView x:Name="DimensionList" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnSelect">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="engine:DimensionInfo">
                    <StackPanel Padding="0,8">
                        <TextBlock Text="{x:Bind Name}" FontSize="16" />
                        <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ScrollViewer Grid.Row="1" Grid.Column="1">
            <StackPanel x:Name="Detail" Spacing="4" Visibility="Collapsed">
                <TextBlock x:Name="NameText" FontSize="24" />
                <TextBlock x:Name="Subtitle" Opacity="0.7" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                    <Button x:Name="EnterButton" Content="Enter" Click="OnEnter" Style="{StaticResource AccentButtonStyle}" />
                    <Button x:Name="LeaveButton" Content="Leave" Click="OnLeave" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Style="{StaticResource VkFootnote}" />

                <TextBlock Text="SPACE" Style="{StaticResource VkSectionHeader}" />
                <Border Style="{StaticResource VkCardStyle}">
                    <StackPanel Spacing="8">
                        <ToggleSwitch x:Name="SpatialSwitch" Header="3D for headphones" IsOn="True" Toggled="OnSpatial" />
                        <controls:SpatialCanvas x:Name="SpaceCanvas" />
                        <Button Content="Reset layout" Click="OnReset" />
                    </StackPanel>
                </Border>

                <TextBlock Text="WHAT IS PLAYING" Style="{StaticResource VkSectionHeader}" />
                <Border Style="{StaticResource VkCardStyle}">
                    <StackPanel x:Name="Layers" Spacing="6" />
                </Border>
                <TextBlock Style="{StaticResource VkFootnote}"
                           Text="Layers come and go with your surroundings: quiet brings strings and woodwinds, loud places raise the synth. On a PC without motion sensors the music follows the room and the time, including the lunar calendar." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
