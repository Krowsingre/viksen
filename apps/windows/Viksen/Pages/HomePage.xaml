<Page
    x:Class="Viksen.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource VkBackgroundBrush}">
    <ScrollViewer>
        <StackPanel MaxWidth="720" Padding="24" Spacing="16">
            <StackPanel Margin="0,24,0,8">
                <TextBlock Text="Viksen" FontSize="44" FontWeight="Light" Foreground="{StaticResource VkAccentBrush}" CharacterSpacing="120" />
                <TextBlock Text="AURAL DIMENSIONS" FontSize="13" Opacity="0.6" CharacterSpacing="300" />
            </StackPanel>

            <Border Style="{StaticResource VkCardStyle}">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock x:Name="MoonGlyph" FontSize="40" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="MoonTitle" FontSize="20" />
                        <TextBlock x:Name="LunarDayText" Opacity="0.7" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource VkCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Experience" FontSize="20" />
                    <TextBlock Text="Built-in Dimensions that listen to the room and to you, rendered in 3D for headphones." TextWrapping="Wrap" Opacity="0.75" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Open Dimensions" Click="OnDimensions" Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Experience controls" Click="OnExperience" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource VkCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Studio" FontSize="20" />
                    <TextBlock Text="Bring your own stems, mix them and place each one around you." TextWrapping="Wrap" Opacity="0.75" />
                    <Button Content="Open Studio" Click="OnStudio" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="EngineNote" Style="{StaticResource VkFootnote}" />
        </StackPanel>
    </ScrollViewer>
</Page>
